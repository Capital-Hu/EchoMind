# EchoMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=EchoMind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 主应用可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）；评测页面必须显式设置
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# EchoMind 模型调用的输出上限（意图识别、改写、重排、记忆、回复）
# 开启思考时需为思考过程和最终答案预留足够额度；未配置时默认 4096
CLAUDE_MAX_TOKENS=4096

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=echomind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 对话记忆 ──────────────────────────────────────────────────────────────────
# 优先检索当前聊天；不足时是否补充同一用户其他聊天的历史
MEMORY_CROSS_CONV_HISTORY=true

# LangGraph 处理进度（与 Chroma、问题记录分开；Docker 内由 compose 覆盖路径）
WORKFLOW_CHECKPOINT_PATH=./data/workflow/checkpoints.sqlite3

# 独立业务 SQLite（MCP Server 读写；Docker 内由 compose 覆盖路径）
BUSINESS_DB_PATH=./data/business/business.sqlite3

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# τ 页面服务要求显式设置 ANTHROPIC_MODEL，默认使用 deepseek/<ANTHROPIC_MODEL>。
# evaluation/web.py 启动时将 ANTHROPIC_API_KEY 复制为 DEEPSEEK_API_KEY，适用于 DeepSeek 凭证。
# 独立 CLI 不复制凭证；运行 DeepSeek 用户/Judge 时需另设 DEEPSEEK_API_KEY。
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 其他供应商及页面配置限制，详见 evaluation/README.md。

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
